// sdtlb 查表时序: 命中向量打 1 拍后再用
//
// 图中例子:
//   拍 1 单拍请求 A (命中) -> 拍 2 出 A 的响应;
//   拍 4 / 拍 5 背靠背请求 B (命中) 与 C (未命中) -> 响应 B 在拍 5, 响应 C 在拍 6;

{
    "head": {
        "text": "sdtlb req_* 请求 (无关 fill_*)",
        "tock": 0,
        "every": 1
    },
    "signal": [
        {
            "name": "clk",
            "wave": "p........"
        },
        {
            "name": "req_en (请求拍)",
            "wave": "010.1.0..",
            "node": ".a..b...."
        },
        {
            "name": "req_pa[47:0]",
            "wave": "x3x.45x..",
            "data": [
                "D-A",
                "D-B",
                "D-C"
            ]
        },
        {
            "name": "req_hit (响应拍)",
            "wave": "0.10.10..",
            "node": "..c..d..."
        },
        {
            "name": "req_hit_tag_item / req_hit_data_item",
            "wave": "x.3x.4x..",
            "data": [
                "Q-A",
                "Q-B"
            ]
        }
    ],
    "edge": [
        "a~>c",
        "b~>d"
    ]
}
